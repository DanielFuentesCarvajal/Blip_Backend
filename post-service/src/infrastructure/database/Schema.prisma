generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Status {
  active
  deleted
}

enum Type {
  post
  comment
}

model Post {
  id           Int       @id @default(autoincrement())
  id_community Int
  id_user      Int
  title        String?
  body         String?
  media        String?
  status       Status
  post_date    DateTime
  comments     Comment[] @relation("PostComments")
  likes        Like[]    @relation("PostLikes")
}

model Comment {
  id               Int       @id @default(autoincrement())
  id_user          Int
  parent_post      Int
  text_body        String?
  image_media      String?
  created_at       DateTime
  status           Status
  id_parent_comment Int?
  post             Post      @relation("PostComments", fields: [parent_post], references: [id])
  parent_comment   Comment?  @relation("CommentReplies", fields: [id_parent_comment], references: [id])
  replies          Comment[] @relation("CommentReplies")
  likes            Like[]    @relation("CommentLikes")
}

model Like {
  id          Int    @id @default(autoincrement())
  id_comment  Int?
  id_post     Int?
  id_user     Int
  like        Boolean
  type        Type
  post        Post?   @relation("PostLikes", fields: [id_post], references: [id])
  comment     Comment? @relation("CommentLikes", fields: [id_comment], references: [id])
}
